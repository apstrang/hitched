# Copy to .env and fill in. Never commit .env.

# --- REQUIRED ---------------------------------------------------------------

# Public hostname of the site, without https:// (used in email and RSVP/QR links).
APP_HOST=wedding.example.com

# Generate with: openssl rand -hex 64
SECRET_KEY_BASE=

# Database password. Use letters and digits only (it goes into a URL).
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Login for /admin (HTTP basic auth). The defaults are admin / password, so change them.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Code guests type at the site gate (RSVP links skip the gate).
WEDDING_INVITE_CODE=

# --- Email (needed for invites, save-the-dates and RSVP confirmations) ------

# SendGrid: set just SENDGRID_API_KEY. Any other SMTP provider: set SMTP_* instead.
SENDGRID_API_KEY=
# SMTP_ADDRESS=smtp.fastmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@example.com
# SMTP_PASSWORD=
# SMTP_DOMAIN=wedding.example.com

# Where contact-form messages and RSVP notifications go
# (defaults to the address in config/initializers/wedding.rb).
# ADMIN_NOTIFICATION_EMAIL=you@example.com
# Recipient for the "send test email" button in the admin.
# TEST_EMAIL_ADDRESS=you@example.com

# --- Port for your reverse proxy --------------------------------------------

# The app is published on APP_BIND:APP_PORT. Keep 127.0.0.1 when the proxy runs
# on the same machine; use 0.0.0.0 if it runs on another host.
APP_BIND=127.0.0.1
APP_PORT=3000

# --- Optional ---------------------------------------------------------------

# RAILS_LOG_LEVEL=info
# GOOGLE_SHEET_URL=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
