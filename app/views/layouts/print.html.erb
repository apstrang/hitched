<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "Print" %> &mdash; <%= WEDDING[:couple_names] %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <style>
      body { margin: 0; padding: 24px; background: #fff; color: #222; font-family: Georgia, 'Times New Roman', serif; }
      .no-print { margin-bottom: 24px; display: flex; gap: 16px; align-items: center; flex-wrap: wrap; font-size: 14px; }
      .no-print a { color: #6B5B4E; }
      @media print {
        body { padding: 0; }
        .no-print { display: none; }
      }
    </style>
    <%= yield :head %>
  </head>
  <body>
    <%= yield %>
  </body>
</html>
