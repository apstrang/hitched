<div class="flex items-center justify-between mb-6">
  <h1 class="type-serif-heading" style="font-size: var(--text-3xl);"><%= @invite.name %></h1>
  <div class="flex gap-2">
    <%= link_to (@invite.responded? ? "Edit RSVP" : "Enter RSVP"), edit_admin_invite_rsvp_path(@invite), class: "btn btn-highlight btn-sm" %>
    <%= link_to "Edit", edit_admin_invite_path(@invite), class: "btn btn-outline btn-sm" %>
    <%= button_to "Delete", admin_invite_path(@invite), method: :delete,
      data: { turbo_confirm: "Are you sure?" },
      class: "btn btn-danger btn-sm" %>
  </div>
</div>

<div class="grid grid-cols-2 gap-4 mb-6" style="font-size: var(--text-sm);">
  <div><span class="text-muted">Email:</span> <%= @invite.email || "N/A" %></div>
  <div><span class="text-muted">Responded:</span> <%= @invite.responded? ? @invite.responded_at.strftime("%b %d, %Y %l:%M %p") : "Not yet" %></div>
  <div><span class="text-muted">Attending:</span> <%= @invite.attending.nil? ? "Pending" : @invite.attending? ? "Yes" : "No" %></div>
  <div><span class="text-muted">Children Attending:</span> <%= @invite.children_attending? ? "Yes" : "No" %></div>
  <div><span class="text-muted">Save-the-date:</span> <%= @invite.save_the_date_sent_at ? "Sent #{@invite.save_the_date_sent_at.strftime("%b %d, %Y")}" : "Not sent" %></div>
  <div><span class="text-muted">Invitation:</span> <%= @invite.invitation_sent_at ? "Sent #{@invite.invitation_sent_at.strftime("%b %d, %Y")}" : "Not sent" %></div>
</div>

<% qr = @invite.rsvp_qr_code %>
<div class="card mb-6" style="display: flex; gap: var(--space-6); align-items: center; flex-wrap: wrap;">
  <div style="width: 160px; flex-shrink: 0;"><%= qr.inline_svg %></div>
  <div style="flex: 1; min-width: 240px; font-size: var(--text-sm);">
    <p style="margin-bottom: var(--space-2);"><span class="text-muted">Permanent link:</span> <%= link_to qr.url, qr.url, target: "_blank", rel: "noopener" %></p>
    <p class="text-muted" style="margin-bottom: var(--space-3);">Opens the home page before RSVPs open and this household's RSVP after. The QR code is the same link, also included in their emails.</p>
    <div class="flex gap-2 flex-wrap">
      <%= link_to "Download PNG", qr_code_admin_invite_path(@invite, format: :png), class: "btn btn-outline btn-sm" %>
      <%= link_to "Download SVG", qr_code_admin_invite_path(@invite, format: :svg), class: "btn btn-outline btn-sm" %>
      <% if @invite.email.present? %>
        <%= button_to (@invite.save_the_date_sent_at ? "Resend Save-the-Date" : "Send Save-the-Date"), send_save_the_date_admin_invite_path(@invite),
          class: "btn btn-outline btn-sm", data: { turbo_confirm: "Email a save-the-date to #{@invite.email}?" } %>
        <%= button_to (@invite.invitation_sent_at ? "Resend Invitation" : "Send Invitation"), send_invitation_admin_invite_path(@invite),
          class: "btn btn-outline btn-sm", data: { turbo_confirm: "Email an invitation to #{@invite.email}?" } %>
      <% end %>
    </div>
  </div>
</div>

<% if @invite.notes.present? %>
  <div class="card mb-6" style="background: var(--color-bg-tertiary);">
    <h2 class="card-title">Notes from Guest</h2>
    <div class="card-body"><%= simple_format(@invite.notes) %></div>
  </div>
<% end %>

<h2 class="type-serif-heading" style="font-size: var(--text-lg); margin-bottom: var(--space-3);">Guests</h2>
<div class="table-wrapper mb-6">
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Meal</th>
        <th>Dietary Notes</th>
        <th>Primary</th>
        <th>Child</th>
        <th>Childcare</th>
      </tr>
    </thead>
    <tbody>
      <% @guests.each do |guest| %>
        <tr>
          <td><%= link_to guest.full_name, admin_guest_path(guest) %></td>
          <td><%= guest.meal_name || "Not chosen" %></td>
          <td class="text-muted"><%= guest.dietary_notes.presence || "None" %></td>
          <td><%= guest.is_primary? ? "Yes" : "" %></td>
          <td><%= guest.is_child? ? "Yes" : "" %></td>
          <td><%= guest.needs_childcare? ? "Yes" : "" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<h2 class="type-serif-heading" style="font-size: var(--text-lg); margin-bottom: var(--space-3);">Invited Events</h2>
<div class="table-wrapper">
  <table>
    <thead>
      <tr>
        <th>Event</th>
        <th>Date</th>
      </tr>
    </thead>
    <tbody>
      <% @events.each do |event| %>
        <tr>
          <td><%= link_to event.name, admin_event_path(event) %></td>
          <td class="text-muted"><%= event.date&.strftime("%b %d, %Y") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
