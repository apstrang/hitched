<%= form_with model: [:admin, menu_option], class: "space-y-4" do |f| %>
  <% if menu_option.errors.any? %>
    <div class="notice-error">
      <% menu_option.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: "form-input", placeholder: "e.g. Braised short rib" %>
  </div>
  <div class="form-group">
    <%= f.label :description, class: "form-label" %>
    <%= f.text_area :description, rows: 2, class: "form-input", placeholder: "Optional notes for you or the caterer" %>
  </div>
  <div class="form-group">
    <%= f.label :sort_order, class: "form-label" %>
    <%= f.number_field :sort_order, class: "form-input", style: "max-width: 120px;" %>
  </div>
  <div class="form-group">
    <label class="flex items-center gap-2">
      <%= f.check_box :active %>
      Show to guests
    </label>
  </div>

  <div class="flex gap-2">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", admin_menu_options_path, class: "btn btn-outline" %>
  </div>
<% end %>
